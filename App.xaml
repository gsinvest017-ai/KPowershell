<Application x:Class="PsTabGroups.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PsTabGroups.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <conv:BoolToArrowConverter          x:Key="BoolToArrow"/>
        <conv:InvertBoolVisibilityConverter x:Key="InvertBoolVis"/>
        <conv:BoolToTabBackgroundConverter  x:Key="BoolToTabBg"/>
        <conv:HexColorConverter             x:Key="HexColor"/>
    </Application.Resources>
</Application>
