<Window x:Class="PsTabGroups.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vm="clr-namespace:PsTabGroups.ViewModels"
        xmlns:models="clr-namespace:PsTabGroups.Models"
        Title="KPowershell" Height="650" Width="1100"
        Background="#141414"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Foreground"   Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"      Value="8,3"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333333"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="T"  Modifiers="Ctrl"       Command="{Binding NewTabInActiveGroupCommand}"/>
        <KeyBinding Key="W"  Modifiers="Ctrl"       Command="{Binding CloseTabCommand}"
                             CommandParameter="{Binding ActiveTab}"/>
        <KeyBinding Key="G"  Modifiers="Ctrl+Shift" Command="{Binding NewGroupCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab Group Bar -->
        <Border Grid.Row="0" Background="#1e1e1e" BorderThickness="0,0,0,1"
                BorderBrush="#333">
            <DockPanel LastChildFill="False">

                <ScrollViewer DockPanel.Dock="Left"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="4,0,0,0">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:TabGroup}">
                                <StackPanel Orientation="Horizontal">

                                    <!-- Group Label -->
                                    <Border Background="{Binding ColorHex, Converter={StaticResource HexColor}}"
                                            CornerRadius="4,4,0,0" Padding="7,3" Margin="2,5,0,0"
                                            Cursor="Hand" VerticalAlignment="Bottom">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding ToggleCollapseCommand}"/>
                                        </Border.InputBindings>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="White" FontSize="11"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding IsCollapsed, Converter={StaticResource BoolToArrow}}"
                                                       Foreground="White" FontSize="9"
                                                       Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Tabs (hidden when group collapsed) -->
                                    <ItemsControl ItemsSource="{Binding Tabs}"
                                                  Visibility="{Binding IsCollapsed, Converter={StaticResource InvertBoolVis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:PsTab}">
                                                <Border Background="{Binding IsActive, Converter={StaticResource BoolToTabBg}}"
                                                        BorderBrush="{Binding DataContext.ColorHex,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                            Converter={StaticResource HexColor}}"
                                                        BorderThickness="1,2,1,0"
                                                        CornerRadius="4,4,0,0"
                                                        Padding="10,4" Margin="1,5,0,0"
                                                        Cursor="Hand" VerticalAlignment="Bottom">
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.ActivateTabCommand,
                                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding}"/>
                                                        <MouseBinding MouseAction="MiddleClick"
                                                                      Command="{Binding DataContext.CloseTabCommand,
                                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding}"/>
                                                    </Border.InputBindings>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="#CCCCCC" FontSize="12"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Content="✕" FontSize="9"
                                                                Foreground="#777" Background="Transparent"
                                                                BorderThickness="0" Margin="6,0,0,0"
                                                                Cursor="Hand" Padding="2,0"
                                                                Command="{Binding DataContext.CloseTabCommand,
                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Content="＋ Tab"   ToolTip="新 Tab (Ctrl+T)"
                            Command="{Binding NewTabInActiveGroupCommand}"
                            Style="{StaticResource HeaderButtonStyle}"/>
                    <Button Content="⊞ Group" ToolTip="新群組 (Ctrl+Shift+G)"
                            Command="{Binding NewGroupCommand}"
                            Style="{StaticResource HeaderButtonStyle}" Margin="4,0,0,0"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Terminal (WebView2) -->
        <wv2:WebView2 x:Name="TerminalWebView"
                      Grid.Row="1"
                      DefaultBackgroundColor="#1A1A1A"/>
    </Grid>
</Window>
