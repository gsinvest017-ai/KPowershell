<Window x:Class="PsTabGroups.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:models="clr-namespace:PsTabGroups.Models"
        Title="KPowershell" Height="650" Width="1100"
        Background="#141414"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- Color swatch circle button -->
        <Style x:Key="ColorSwatchStyle" TargetType="Button">
            <Setter Property="Width"            Value="24"/>
            <Setter Property="Height"           Value="24"/>
            <Setter Property="Margin"           Value="3"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="12"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header button -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="8,3"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333333"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Inline rename TextBox — 自動 focus + SelectAll + 鍵盤處理 -->
        <Style x:Key="RenameBoxStyle" TargetType="TextBox">
            <Setter Property="Background"      Value="#2a2a2a"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="CaretBrush"      Value="#d4a017"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"     Value="#d4a017"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="2,0"/>
            <Setter Property="MinWidth"        Value="50"/>
            <Setter Property="MaxWidth"        Value="160"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <!-- IsVisibleChanged 是 CLR event，不能放 EventSetter，改在各元素直接掛 -->
            <EventSetter Event="PreviewKeyDown" Handler="RenameBox_PreviewKeyDown"/>
            <EventSetter Event="LostFocus"      Handler="RenameBox_LostFocus"/>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="T"  Modifiers="Ctrl"       Command="{Binding NewTabInActiveGroupCommand}"/>
        <KeyBinding Key="W"  Modifiers="Ctrl"       Command="{Binding CloseTabCommand}"
                             CommandParameter="{Binding ActiveTab}"/>
        <KeyBinding Key="G"  Modifiers="Ctrl+Shift" Command="{Binding NewGroupCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Tab Group Bar ═══ -->
        <Border Grid.Row="0" Background="#1e1e1e" BorderThickness="0,0,0,1" BorderBrush="#333">
            <DockPanel LastChildFill="False">

                <ScrollViewer DockPanel.Dock="Left"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="4,0,0,0">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:TabGroup}">
                                <StackPanel Orientation="Horizontal"
                                            AllowDrop="True"
                                            DragEnter="Group_DragEnter"
                                            Drop="Group_Drop">

                                    <!-- ── Group Label ─────────────────────────── -->
                                    <Border Background="{Binding ColorHex, Converter={StaticResource HexColor}}"
                                            CornerRadius="4,4,0,0" Padding="6,3" Margin="2,5,0,0"
                                            VerticalAlignment="Bottom"
                                            MouseRightButtonUp="GroupLabel_RightClick">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                            <!-- Name: display mode (雙擊 → rename) -->
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Cursor="IBeam"
                                                       Visibility="{Binding IsEditing, Converter={StaticResource InvertBoolVis}}">
                                                <TextBlock.InputBindings>
                                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                                  Command="{Binding StartRenameCommand}"/>
                                                </TextBlock.InputBindings>
                                            </TextBlock>

                                            <!-- Name: edit mode (TextBox) -->
                                            <TextBox Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource RenameBoxStyle}"
                                                     Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                                     IsVisibleChanged="RenameBox_IsVisibleChanged"/>

                                            <!-- Arrow: 點擊 → collapse/expand (與 rename 互不干擾) -->
                                            <TextBlock Text="{Binding IsCollapsed, Converter={StaticResource BoolToArrow}}"
                                                       Foreground="White" FontSize="9" Opacity="0.8"
                                                       Margin="5,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                                                       ToolTip="收折群組">
                                                <TextBlock.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding ToggleCollapseCommand}"/>
                                                </TextBlock.InputBindings>
                                            </TextBlock>

                                        </StackPanel>
                                    </Border>

                                    <!-- ── Tabs (hidden when group collapsed) ──── -->
                                    <ItemsControl ItemsSource="{Binding Tabs}"
                                                  Visibility="{Binding IsCollapsed, Converter={StaticResource InvertBoolVis}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:PsTab}">
                                                <Border Background="{Binding IsActive, Converter={StaticResource BoolToTabBg}}"
                                                        BorderBrush="{Binding ColorHex, Converter={StaticResource HexColor}}"
                                                        BorderThickness="1,2,1,0"
                                                        CornerRadius="4,4,0,0"
                                                        Padding="10,3" Margin="1,5,0,0"
                                                        Cursor="Hand" VerticalAlignment="Bottom"
                                                        MouseRightButtonUp="TabBorder_RightClick"
                                                        PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="Tab_PreviewMouseMove">
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.ActivateTabCommand,
                                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding}"/>
                                                        <MouseBinding MouseAction="MiddleClick"
                                                                      Command="{Binding DataContext.CloseTabCommand,
                                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding}"/>
                                                    </Border.InputBindings>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                        <!-- Title: display mode (雙擊 → rename) -->
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="#CCCCCC" FontSize="12"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IsEditing, Converter={StaticResource InvertBoolVis}}">
                                                            <TextBlock.InputBindings>
                                                                <MouseBinding MouseAction="LeftDoubleClick"
                                                                              Command="{Binding StartRenameCommand}"/>
                                                            </TextBlock.InputBindings>
                                                        </TextBlock>

                                                        <!-- Title: edit mode (TextBox) -->
                                                        <TextBox Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource RenameBoxStyle}"
                                                                 FontWeight="Normal"
                                                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                                                 IsVisibleChanged="RenameBox_IsVisibleChanged"/>

                                                        <!-- Close button -->
                                                        <Button Content="✕" FontSize="9"
                                                                Foreground="#777" Background="Transparent"
                                                                BorderThickness="0" Margin="6,0,0,0"
                                                                Cursor="Hand" Padding="2,0"
                                                                Command="{Binding DataContext.CloseTabCommand,
                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Right buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Content="＋ Tab"   ToolTip="新 Tab (Ctrl+T)"
                            Command="{Binding NewTabInActiveGroupCommand}"
                            Style="{StaticResource HeaderButtonStyle}"/>
                    <Button Content="⊞ Group" ToolTip="新群組 (Ctrl+Shift+G)"
                            Command="{Binding NewGroupCommand}"
                            Style="{StaticResource HeaderButtonStyle}" Margin="4,0,0,0"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Terminal (WebView2) -->
        <wv2:WebView2 x:Name="TerminalWebView"
                      Grid.Row="1"
                      DefaultBackgroundColor="#1A1A1A"/>

        <!-- ═══ Color Picker Popup ═══ -->
        <Popup x:Name="ColorPickerPopup"
               StaysOpen="False" AllowsTransparency="True"
               Placement="Bottom" HorizontalOffset="-4" VerticalOffset="4">
            <Border Background="#252525" BorderBrush="#555" BorderThickness="1"
                    CornerRadius="7" Padding="10,8">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="14" Opacity="0.55" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="顏色" FontSize="10" Foreground="#888" Margin="0,0,0,7"/>
                    <UniformGrid Columns="6">
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#C50F1F" Tag="#C50F1F" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#FF6B35" Tag="#FF6B35" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#E8CB2D" Tag="#E8CB2D" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#16C60C" Tag="#16C60C" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#00B7C3" Tag="#00B7C3" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#4ECDC4" Tag="#4ECDC4" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#3B78FF" Tag="#3B78FF" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#881798" Tag="#881798" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#A78BFA" Tag="#A78BFA" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#E74856" Tag="#E74856" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#767676" Tag="#767676" Click="ColorSwatch_Click"/>
                        <Button Style="{StaticResource ColorSwatchStyle}" Background="#DEDEDE" Tag="#DEDEDE" Click="ColorSwatch_Click"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
